# Recommended starting configuration
# Each faculty inherits the global model unless a role-specific
# model is configured below.
# Provider: openai | local | codex_cli | echo (isolated test stub, no LLM)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Optional role-specific OpenAI models
# routing: context selection model
ROUTING_OPENAI_MODEL=
# conversation: internal conversation judgments and memory selection
CONVERSATION_OPENAI_MODEL=
# memory: after-turn MemoryAgent model
MEMORY_OPENAI_MODEL=
# The daemon requests medium reasoning for routing and internal
# conversational judgments, and high reasoning for memory maintenance.
# Optional advanced overrides: low | medium | high
# ROUTING_REASONING_EFFORT=medium
# CONVERSATION_REASONING_EFFORT=medium
# MEMORY_REASONING_EFFORT=high

# Optional role-specific providers: openai | local | codex_cli | echo
# Defaults to LLM_PROVIDER when unset.
ROUTING_LLM_PROVIDER=
CONVERSATION_LLM_PROVIDER=
MEMORY_LLM_PROVIDER=
REM_LLM_PROVIDER=
# Followup fire judge. The Hermes installer defaults this async role to codex_cli.
FOLLOWUP_LLM_PROVIDER=codex_cli

# Local OpenAI-compatible provider
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_API_KEY=local-key
LOCAL_LLM_MODEL=local-model-name

# Optional role-specific local models
ROUTING_LOCAL_LLM_MODEL=
CONVERSATION_LOCAL_LLM_MODEL=
MEMORY_LOCAL_LLM_MODEL=

# Experimental Codex CLI provider.
# Uses the local Codex CLI ChatGPT/Codex login, not OPENAI_API_KEY.
# Recommended only for async roles such as MEMORY_* and future DREAMING_*.
CODEX_CLI_BIN=codex
CODEX_CLI_MODEL=gpt-5.5
CODEX_CLI_PROFILE=
CODEX_CLI_TIMEOUT_SECONDS=300
MEMORY_CODEX_MODEL=gpt-5.5
# Optional override; otherwise follows CONVERSATION_CODEX_MODEL/CODEX_CLI_MODEL.
FOLLOWUP_CODEX_MODEL=

# Telegram optional
TELEGRAM_BOT_TOKEN=

# Shared automation identity and optional memory root.
DAEMON_CORE_USER_ID=
DAEMON_CORE_MEMORY_ROOT=
# Set by the service installer or Docker build for deployment attestation.
DAEMON_CORE_RUNTIME_REVISION=

# Hermes voice plugin. When enabled for a platform, the canonical voice,
# exact-memory tools and Scene Model are one indivisible runtime.
DAEMON_CORE_SOVEREIGN_VOICE=off
DAEMON_CORE_SOVEREIGN_PLATFORMS=telegram

# Experimental Hermes-only progress preamble. Exact value `canary` is required;
# the plugin then asks the same host model for one brief visible commentary
# sentence before its first tool. No extra model or tool call is introduced.
DAEMON_CORE_HERMES_PROGRESS_PREAMBLE=off
DAEMON_CORE_HERMES_PROGRESS_PREAMBLE_PLATFORMS=telegram

# One-shot private audit of the next canonical first provider call. The target
# must be a new .json file below exports/private; existing files are never
# overwritten. Leave empty during normal operation: the payload contains the
# exact personal prompt and tool schemas.
DAEMON_CORE_VOICE_CAPTURE_FILE=

# Exclusive semantic writer for the bounded personal agenda. MemoryAgent and
# Dreaming never write agenda.md; enable this faculty only for explicit users.
DAEMON_CORE_TEMPORAL_CURATOR=off
DAEMON_CORE_TEMPORAL_CURATOR_USER_IDS=

# Dreaming daily automation
DREAMING_SINCE_HOURS=24
DREAMING_DAILY_TIME=04:00
# Nightly Codex CLI deadline; interactive calls retain
# CODEX_CLI_TIMEOUT_SECONDS.
DREAMING_CODEX_TIMEOUT_SECONDS=600
# Set to 1/true/yes to make scripts/run_dreaming_daily.sh report only without applying updates.
DREAMING_DRY_RUN=0
# Optional list (":" on Unix, ";" on Windows) of continuity receipt directories
# read by Dreaming. Useful when several hosts write separate journals.
DREAMING_CONTINUITY_RECEIPT_DIRS=

# Observational audit of contextual memory coverage. It never changes replies.
DAEMON_CORE_MEMORY_COVERAGE_SHADOW=false

# Append-only technical receipts for turn continuity. `shadow` observes only:
# no prompt, reply, LLM call or retry behavior is changed.
DAEMON_CORE_CONTINUITY_RECEIPTS=off
DAEMON_CORE_CONTINUITY_RECEIPT_DIR=

# Durable after-turn queue shared by Hermes and OpenClaw. Disabled by default.
# Jobs contain technical metadata and verified L0 references, never a second
# copy of the conversation. Use one explicit directory for every host attached
# to the same daemon instance.
DAEMON_CORE_AFTER_TURN_SPOOL=off
DAEMON_CORE_AFTER_TURN_SPOOL_DIR=
# `external` makes the neutral LaunchAgent the sole consumer. Hermes and
# OpenClaw then only append jobs to the shared queue.
DAEMON_CORE_AFTER_TURN_OWNER=off
DAEMON_CORE_AFTER_TURN_USER_IDS=
# Host-side pin of the independently deployed service revision. The macOS
# installers populate it automatically; it need not equal the host revision.
DAEMON_CORE_AFTER_TURN_SERVICE_REVISION=

# OpenClaw 2026.8+ runtime guard. When configured, /ready checks both the
# durable host outbox and the content-free per-session canonical prompt state.
DAEMON_CORE_OPENCLAW_AGENT_DB=
DAEMON_CORE_OPENCLAW_HEALTH_FILE=

# MemoryAgent and Temporal Curator still process every exact turn. The durable
# worker refreshes replaceable conversation/follow-up views once after each
# drained FIFO burst; this does not need another flag. The option below adds
# coalescing of the replaceable Scene Model projection as well.
# Continuity receipts and the durable after-turn spool are both required.
DAEMON_CORE_SCENE_COALESCING=off

# Optional local semantic shortlist for the exact Markdown Atlas. Embeddings
# are a disposable routing cache, never a source of personal facts. When the
# durable after-turn worker is enabled, missing vectors are filled once after
# each drained burst; Dreaming refreshes once after its complete write batch.
# The same selector is available to the canonical Hermes/Telegram and OpenClaw
# paths; keep the user allowlist explicit in every host environment.
DAEMON_CORE_ATLAS_EMBEDDING_TOP12=off
DAEMON_CORE_ATLAS_EMBEDDING_TOP12_USER_IDS=
DAEMON_CORE_ATLAS_EMBEDDING_CACHE=
DAEMON_CORE_ATLAS_EMBEDDING_MODEL=qwen3-embedding:0.6b
DAEMON_CORE_ATLAS_EMBEDDING_URL=http://127.0.0.1:11434

# Optional authority hierarchy for the canonical voice brief. Both identity
# and platform must be explicitly allowlisted.
DAEMON_CORE_NARRATIVE_AUTHORITY_HIERARCHY=off
DAEMON_CORE_NARRATIVE_AUTHORITY_HIERARCHY_USER_IDS=
DAEMON_CORE_NARRATIVE_AUTHORITY_HIERARCHY_PLATFORMS=telegram,openclaw

# Experimental Scene Model foreground. The existing after-turn scene judgment
# may maintain at most three user-sourced current topics and expose them to the
# voice. Active only in `canary` mode for exact user ids; `*` is refused.
DAEMON_CORE_CURRENT_TOPICS=off
DAEMON_CORE_CURRENT_TOPICS_USER_IDS=

# Shadow bounded recovery: when the coverage audit flags a missing required
# piece, run one guided second recall pass and trace what it would have found.
# Observational only — it never changes or delays replies.
DAEMON_CORE_MEMORY_RECOVERY_SHADOW=false

# Exceptional L0 forensics, still observational: only after capsule recovery
# remains missing/partial, choose at most two justified daily files and require
# an exact quote from a user turn. Never injects or repairs memory.
DAEMON_CORE_MEMORY_FORENSIC_SHADOW=false

# Coverage-to-voice: on factual-recall scenes (gate: pratique register + required
# needs), run coverage synchronously and hand the voice a sober dossier of what
# is established vs missing. Costs one judge call on gated turns only.
DAEMON_CORE_COVERAGE_TO_VOICE=false

# Experimental P1b. `shadow` asks the radar for final leaves but keeps the
# current selector sovereign; `off` is the production-safe default.
DAEMON_CORE_RADAR_FINAL_SELECTION=off

# Experimental situated-context contract. When enabled, the existing radar
# also carries a compact established/uncertain decision frame to the voice.
# No extra LLM call is added. Keep off outside an explicit canary.
DAEMON_CORE_SITUATED_CONTEXT=off

# Experimental Common Ground extractor. Shadow mode extends the existing
# after-turn MemoryAgent judgment and writes exact-provenance candidates only.
# The response voice never reads this trace. An explicit allowlist is required.
DAEMON_CORE_COMMON_GROUND_SHADOW=off
DAEMON_CORE_COMMON_GROUND_SHADOW_USER_IDS=

# Read-only Common Ground library projection. Only consolidated lineages with
# resolvable L0 provenance become visible to the existing exact-memory tool.
# Active modes still require an explicit user allowlist; optionally restrict
# exposure to host names such as `telegram` or `openclaw`.
DAEMON_CORE_COMMON_GROUND_LIBRARY=off
DAEMON_CORE_COMMON_GROUND_LIBRARY_USER_IDS=
DAEMON_CORE_COMMON_GROUND_LIBRARY_PLATFORMS=

# Shared faculties remain disabled until an explicit
# user identity is allowed.
DAEMON_CORE_SCENE_MODEL=off
DAEMON_CORE_SCENE_MODEL_USER_IDS=
DAEMON_CORE_L0_RECALL_TOOL=off
DAEMON_CORE_L0_RECALL_USER_IDS=
DAEMON_CORE_FOLLOWUPS=off
DAEMON_CORE_FOLLOWUPS_DRYRUN=off
DAEMON_CORE_REM_EPISODIC_SCENES=off
DAEMON_CORE_REM_EPISODIC_SCENE_USER_IDS=
DAEMON_CORE_REM_EPISODIC_SCENE_PLATFORMS=telegram,openclaw

# Markdown relations and observational modes. Active private settings
# belong outside Git, never in this example.
DAEMON_CORE_RELATION_GARDENING=off
DAEMON_CORE_RELATION_GARDENING_USER_IDS=
DAEMON_CORE_MEMORY_RELATION_PUBLICATION=off
DAEMON_CORE_MEMORY_RELATION_PUBLICATION_USER_IDS=
DAEMON_CORE_MEMORY_RELATION_SHADOW=off
DAEMON_CORE_MEMORY_RELATION_SHADOW_USER_IDS=
DAEMON_CORE_MEMORY_COLLECTION_BOOTSTRAP_SHADOW=off
DAEMON_CORE_MEMORY_COLLECTION_BOOTSTRAP_SHADOW_USER_IDS=
DAEMON_CORE_MEMORY_TOPOLOGY_BUNDLE_SHADOW=off
DAEMON_CORE_MEMORY_TOPOLOGY_BUNDLE_SHADOW_USER_IDS=
DAEMON_CORE_MEMORY_PERFORMATIVE_RELATION_RETRACTIONS=off
DAEMON_CORE_MEMORY_PERFORMATIVE_RELATION_RETRACTIONS_USER_IDS=
