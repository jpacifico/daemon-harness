{
  "$id": "https://github.com/jpacifico/daemon-harness/benchmarks/productivity_v1/run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arm_id": {
      "enum": [
        "A",
        "C"
      ]
    },
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "name",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "campaign_id": {
      "minLength": 1,
      "type": "string"
    },
    "exclusion": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "minLength": 1,
              "type": "string"
            },
            "evidence": {
              "minLength": 1,
              "type": "string"
            },
            "replacement_seed": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "code",
            "evidence",
            "replacement_seed"
          ],
          "type": "object"
        }
      ]
    },
    "fixture_ref": {
      "minLength": 8,
      "type": "string"
    },
    "host_id": {
      "enum": [
        "hermes",
        "openclaw"
      ]
    },
    "language": {
      "const": "en"
    },
    "outcome": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authoritative": {
              "type": "boolean"
            },
            "checks": {
              "additionalProperties": {
                "type": "boolean"
              },
              "minProperties": 1,
              "type": "object"
            },
            "success_first_attempt": {
              "type": "boolean"
            },
            "success_within_episode": {
              "type": "boolean"
            }
          },
          "required": [
            "authoritative",
            "checks",
            "success_first_attempt",
            "success_within_episode"
          ],
          "type": "object"
        }
      ]
    },
    "pair_id": {
      "minLength": 1,
      "type": "string"
    },
    "protocol_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "daemon.public-productivity.run.v1"
    },
    "seed": {
      "minimum": 0,
      "type": "integer"
    },
    "session_ref": {
      "pattern": "^[a-f0-9]{16}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "excluded"
      ]
    },
    "timing": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "correct_result_ms": {
              "$ref": "#/$defs/nullableMilliseconds"
            },
            "daemon_compose_ms": {
              "$ref": "#/$defs/nullableMilliseconds"
            },
            "first_visible_ms": {
              "$ref": "#/$defs/nullableMilliseconds"
            },
            "host_ms": {
              "$ref": "#/$defs/nullableMilliseconds"
            },
            "startup_ms": {
              "$ref": "#/$defs/nullableMilliseconds"
            },
            "tool_ms": {
              "$ref": "#/$defs/nullableMilliseconds"
            },
            "wall_ms": {
              "$ref": "#/$defs/nullableMilliseconds"
            }
          },
          "required": [
            "wall_ms",
            "startup_ms",
            "first_visible_ms",
            "correct_result_ms",
            "host_ms",
            "daemon_compose_ms",
            "tool_ms"
          ],
          "type": "object"
        }
      ]
    },
    "tokens": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "daemon.background": {
              "$ref": "#/$defs/tokenScope"
            },
            "daemon.critical": {
              "$ref": "#/$defs/tokenScope"
            },
            "host.background": {
              "$ref": "#/$defs/tokenScope"
            },
            "host.visible": {
              "$ref": "#/$defs/tokenScope"
            }
          },
          "required": [
            "host.visible",
            "daemon.critical",
            "host.background",
            "daemon.background"
          ],
          "type": "object"
        }
      ]
    },
    "tool_calls": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "duration_ms": {
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ]
          }
        },
        "required": [
          "name",
          "status",
          "duration_ms"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "campaign_id",
    "run_id",
    "pair_id",
    "host_id",
    "arm_id",
    "scenario_id",
    "seed",
    "fixture_ref",
    "session_ref",
    "language",
    "attempt",
    "status",
    "timing",
    "tokens",
    "tool_calls",
    "outcome",
    "exclusion",
    "artifacts"
  ],
  "title": "Public Productivity Benchmark V1 run record",
  "type": "object",
  "$defs": {
    "nullableMilliseconds": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "tokenScope": {
      "additionalProperties": false,
      "properties": {
        "cache_read": {
          "$ref": "#/$defs/tokenValue"
        },
        "cache_write": {
          "$ref": "#/$defs/tokenValue"
        },
        "call_count": {
          "minimum": 0,
          "type": "integer"
        },
        "input_uncached": {
          "$ref": "#/$defs/tokenValue"
        },
        "output": {
          "$ref": "#/$defs/tokenValue"
        },
        "reasoning": {
          "$ref": "#/$defs/tokenValue"
        },
        "total": {
          "$ref": "#/$defs/tokenValue"
        }
      },
      "required": [
        "call_count",
        "input_uncached",
        "cache_read",
        "cache_write",
        "output",
        "reasoning",
        "total"
      ],
      "type": "object"
    },
    "tokenValue": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "quality": {
                "const": "unavailable"
              }
            },
            "required": [
              "quality"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        }
      ],
      "properties": {
        "quality": {
          "enum": [
            "provider_reported",
            "host_reported",
            "tokenizer_estimated",
            "unavailable"
          ]
        },
        "value": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "value",
        "quality"
      ],
      "type": "object"
    }
  }
}
